---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
  <main>
    <!-- PAGE HEADER -->
    <section class="bg-[#1e5f6b] text-white">
      <div class="max-w-5xl mx-auto px-6 py-14 flex flex-col gap-3">
        <p class="text-white/60 text-sm font-medium uppercase tracking-widest">O projektu</p>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">Kdo stoji za Viridexom?</h1>
        <p class="text-white/75 max-w-xl text-base">
          Viridex je neodvisna platforma za kakovostna učna gradiva, zasnovana po uradnem katalogu
          RIC.
        </p>
      </div>
    </section>

    <section class="bg-gray-50 py-14">
      <div class="max-w-5xl mx-auto px-6 flex flex-col gap-6">
        <!-- Top row: two cards side by side -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
          <!-- Company info card (wider) -->
          <div
            class="md:col-span-3 bg-white border border-gray-200 rounded-xl p-7 flex flex-col gap-5"
          >
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center shrink-0">
                <Icon name="ph:buildings-light" class="w-4 h-4 text-teal-700" />
              </div>
              <h2 class="text-base font-extrabold text-gray-900">Kontaktni podatki</h2>
            </div>
            <div class="flex flex-col divide-y divide-gray-100">
              <div class="flex items-center gap-3 py-3">
                <Icon name="ph:buildings-light" class="w-4 h-4 text-teal-700 shrink-0" />
                <span
                  class="text-xs font-semibold text-gray-400 uppercase tracking-wider w-24 shrink-0"
                  >Podjetje</span
                >
                <span class="text-sm text-gray-800 font-medium">IntraLab, Miha Meglič s.p.</span>
              </div>
              <div class="flex items-center gap-3 py-3">
                <Icon name="ph:envelope-light" class="w-4 h-4 text-teal-700 shrink-0" />
                <span
                  class="text-xs font-semibold text-gray-400 uppercase tracking-wider w-24 shrink-0"
                  >E-pošta</span
                >
                <a
                  href="mailto:info@viridex.si"
                  class="text-sm text-teal-700 font-medium hover:underline"
                >
                  info@viridex.si
                </a>
              </div>
              <div class="flex items-center gap-3 py-3">
                <Icon name="ph:globe-light" class="w-4 h-4 text-teal-700 shrink-0" />
                <span
                  class="text-xs font-semibold text-gray-400 uppercase tracking-wider w-24 shrink-0"
                  >Spletna stran</span
                >
                <a
                  href="https://viridex.si"
                  class="text-sm text-teal-700 font-medium hover:underline"
                >
                  viridex.si
                </a>
              </div>
            </div>
          </div>

          <!-- Mission card (narrower) -->
          <div class="md:col-span-2 bg-teal-700 rounded-xl p-7 flex flex-col gap-4 justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-white/15 flex items-center justify-center shrink-0">
                <Icon name="ph:lightbulb-light" class="w-4 h-4 text-white" />
              </div>
              <h2 class="text-base font-extrabold text-white">Naše poslanstvo</h2>
            </div>
            <p class="text-sm text-white/80 leading-relaxed">
              Dijakom ponuditi strukturirana, brezplačna in kakovostna učna gradiva, ki sledijo
              uradnemu predmetnemu katalogu RIC - brez odvečnega šuma.
            </p>
            <a
              href="/#gradiva"
              class="self-start inline-flex items-center gap-1.5 text-sm font-semibold text-white bg-white/15 hover:bg-white/25 transition-colors px-4 py-2 rounded-lg"
            >
              Oglej si gradiva
              <Icon name="ph:arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Disclaimer card -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 flex gap-4">
          <Icon name="ph:warning-circle-light" class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
          <p class="text-sm text-amber-800 leading-relaxed">
            <span class="font-semibold text-amber-900">Pomembno: </span>Viridex ni uradni zastopnik
            Državnega izpitnega centra (RIC). Vsa gradiva so pripravljena neodvisno in temeljijo na
            javno dostopnih predmetnih katalogih. Za uradne informacije obiščite <a
              href="https://www.ric.si"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold underline hover:text-amber-900">ric.si</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
