---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const handbooks: {
  subject: string;
  description: string;
  status: 'available' | 'coming';
}[] = [
  {
    subject: 'Računalništvo',
    description: 'Celovit maturitetni priročnik po uradnem katalogu RIC.',
    status: 'available',
  },
  {
    subject: 'Matematika',
    description:
      'Maturitetni priročnik za matematiko v pripravi. Pokrivali bomo algebro, analizo ter verjetnost in statistiko po katalogu RIC.',
    status: 'coming',
  },
];

const books: {
  subject: string;
  description: string;
  status: 'available' | 'coming';
}[] = [
  {
    subject: 'Računalništvo',
    description:
      'Poglobljeni učbenik za računalništvo z razširjenimi razlagami, primeri in vajami. Primeren za samostojno učenje skozi celo šolsko leto.',
    status: 'coming',
  },
];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="bg-[#1e5f6b] text-white">
      <div class="max-w-5xl mx-auto px-6 py-20 flex flex-col items-center text-center gap-6">
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight max-w-2xl">
          Priprave na maturo po katalogu RIC
        </h1>
        <p class="text-white/75 max-w-xl text-base md:text-lg">
          Celovito in strukturirano gradivo za računalništvo, zasnovano za samostojno učenje in
          hitro ponavljanje pred izpitom.
        </p>
        <a
          href="#katalog"
          class="inline-flex items-center gap-2 bg-white text-teal-700 font-semibold text-sm px-6 py-3 rounded-lg hover:bg-gray-100 transition-colors shadow"
        >
          Začni s pregledom
          <Icon name="ph:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </section>

    <!-- GRADIVA -->
    <section id="gradiva" class="bg-gray-50 py-16">
      <div class="max-w-5xl mx-auto px-6 flex flex-col gap-14">
        <!-- Maturitetni priročniki -->
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
            <div>
              <h2 class="text-2xl font-extrabold text-gray-900">Maturitetni priročniki</h2>
              <p class="text-sm text-gray-500 mt-1">
                Strukturirano gradivo po uradnem katalogu RIC za pripravo na maturo.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {
              handbooks.map((item) => (
                <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col gap-4 hover:shadow-md transition-shadow">
                  <div class="flex items-start justify-between">
                    <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center">
                      <Icon name="ph:book-open-text-light" class="w-4 h-4 text-teal-700" />
                    </div>
                    {item.status === 'available' ? (
                      <span class="text-[10px] font-bold tracking-widest uppercase text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
                        Na voljo
                      </span>
                    ) : (
                      <span class="text-[10px] font-bold tracking-widest uppercase text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">
                        Kmalu
                      </span>
                    )}
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900 mb-1">{item.subject}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{item.description}</p>
                  </div>
                  {item.status === 'available' ? (
                    <a
                      href="#"
                      class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-gray-700 border border-gray-200 rounded-lg px-3 py-2 hover:bg-gray-50 transition-colors"
                    >
                      Odpri priročnik
                      <Icon name="ph:caret-right" class="w-3.5 h-3.5" />
                    </a>
                  ) : (
                    <span class="mt-auto inline-flex items-center gap-1.5 text-sm text-gray-400 border border-dashed border-gray-200 rounded-lg px-3 py-2 cursor-default">
                      <Icon name="ph:clock-light" class="w-3.5 h-3.5" />V pripravi
                    </span>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Učbeniki -->
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
            <div>
              <h2 class="text-2xl font-extrabold text-gray-900">Učbeniki</h2>
              <p class="text-sm text-gray-500 mt-1">
                Poglobljeni učbeniki za celostno razumevanje snovi skozi celo šolsko leto.
              </p>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {
              books.map((item) => (
                <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col gap-4 hover:shadow-md transition-shadow">
                  <div class="flex items-start justify-between">
                    <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center">
                      <Icon name="ph:graduation-cap-light" class="w-4 h-4 text-teal-700" />
                    </div>
                    {item.status === 'available' ? (
                      <span class="text-[10px] font-bold tracking-widest uppercase text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
                        Na voljo
                      </span>
                    ) : (
                      <span class="text-[10px] font-bold tracking-widest uppercase text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full">
                        Kmalu
                      </span>
                    )}
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900 mb-1">{item.subject}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{item.description}</p>
                  </div>
                  {item.status === 'available' ? (
                    <a
                      href="#"
                      class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-gray-700 border border-gray-200 rounded-lg px-3 py-2 hover:bg-gray-50 transition-colors"
                    >
                      Odpri učbenik
                      <Icon name="ph:caret-right" class="w-3.5 h-3.5" />
                    </a>
                  ) : (
                    <span class="mt-auto inline-flex items-center gap-1.5 text-sm text-gray-400 border border-dashed border-gray-200 rounded-lg px-3 py-2 cursor-default">
                      <Icon name="ph:clock-light" class="w-3.5 h-3.5" />V pripravi
                    </span>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
